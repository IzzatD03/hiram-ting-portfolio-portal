{
  "name": "hiramting-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run stage:cloudflare-content",
    "dev": "next dev",
    "build": "next build",
    "postbuild": "opennextjs-cloudflare build --skipNextBuild",
    "start": "next start",
    "preview": "npm run build && opennextjs-cloudflare preview",
    "deploy": "npm run build && opennextjs-cloudflare deploy",
    "upload": "npm run build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "stage:cloudflare-content": "tsx scripts/stage-cloudflare-content.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:content": "tsx scripts/validate-content.ts",
    "check:assets": "tsx scripts/check-assets.ts",
    "check": "npm run validate:content && npm run check:assets && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "csv-parse": "^7.0.2",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.12",
    "tsx": "^4.23.5",
    "typescript": "^5.9.0",
    "wrangler": "^4.118.0"
  }
}
